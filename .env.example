# ── Base de données (Supabase) ──────────────────────────────────────────────
# Dans Supabase : bouton "Connect" en haut de la page du projet → section
# "Session pooler" ou "Transaction pooler" (PAS "Direct connection").
DATABASE_URL="postgresql://postgres.xxxxxxxx:VOTRE_MOT_DE_PASSE@aws-1-eu-west-1.pooler.supabase.com:6543/postgres"

# ── Authentification ─────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="360d"

# ── Stockage fichiers (optionnel, peut aussi être Supabase Storage) ─────────
STORAGE_BUCKET_URL=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# ── Paiement (à activer seulement quand une vraie intégration existe) ──────
ORANGE_MONEY_ENABLED="false"

# ── Commandes récurrentes (Vercel Cron) ─────────────────────────────────────
# Générez une valeur aléatoire (ex: openssl rand -hex 24) et ajoutez-la
# aussi dans les variables d'environnement Vercel. Vercel Cron envoie
# automatiquement "Authorization: Bearer <CRON_SECRET>" à chaque appel
# planifié si cette variable est définie.
CRON_SECRET="change-this-random-value"
