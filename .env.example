# ── Base de données (Supabase) ──────────────────────────────────────────────
# Dans Supabase : Project Settings → Database → Connection string → "URI"
# Utilisez la chaîne "Connection pooling" (port 6543) en production sur Vercel
# car les fonctions serverless ouvrent beaucoup de connexions courtes.
# Ajoutez ?pgbouncer=true à la fin de l'URL avec le pooler.
DATABASE_URL="postgresql://postgres.xxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── Authentification ─────────────────────────────────────────────────────────
# Générez une valeur longue et aléatoire, ex: openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ── Stockage fichiers (optionnel, peut aussi être Supabase Storage) ─────────
STORAGE_BUCKET_URL=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# ── Paiement (à activer seulement quand une vraie intégration existe) ──────
ORANGE_MONEY_ENABLED="false"
